# Все переменные необязательны.

# SQLite по умолчанию. Для Postgres: postgresql+asyncpg://user:pass@host/db
WT_DATABASE_URL=sqlite+aiosqlite:///./watchtower.db

# Если задан, /api/* и /metrics требуют заголовок X-API-Key.
# Обязательно задайте, если сервис доступен из интернета.
WT_API_KEY=

# Алерты в Telegram
WT_TELEGRAM_BOT_TOKEN=
WT_TELEGRAM_CHAT_ID=
# Универсальный webhook (Slack/Discord/свой сервис), получает JSON
WT_WEBHOOK_URL=

# Разрешить мониторить localhost и приватные сети (по умолчанию запрещено — защита от SSRF)
WT_ALLOW_PRIVATE_TARGETS=false
# Публичная страница /status (без URL мониторов и текстов ошибок)
WT_PUBLIC_STATUS_PAGE=true
# За сколько дней предупреждать об истечении SSL-сертификата
WT_TLS_WARN_DAYS=14
# Сколько дней хранить историю проверок
WT_RETENTION_DAYS=30
